{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "server", "electron", "src/desktop/types.ts", "src/desktop/changelog.ts", "src/engine/computerPolicy.ts", "src/engine/toolBlocks.ts", "src/types", "playwright.desktop.config.ts"]
}
