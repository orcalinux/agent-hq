{
  "name": "agent-hq-demo",
  "private": true,
  "type": "module",
  "description": "The Agent HQ video series: a narrated overview and recorded tutorials, rendered with Remotion.",
  "scripts": {
    "voice": "node scripts/voice.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Overview out/00-overview.mp4 --codec h264 --crf 16",
    "still": "remotion still src/index.ts Overview out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/transitions": "4.0.545",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.545",
    "@remotion/google-fonts": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "5.8.3"
  }
}
