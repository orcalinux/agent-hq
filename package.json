{
  "name": "agent-hq",
  "productName": "Agent HQ",
  "desktopName": "agent-hq.desktop",
  "private": true,
  "license": "MIT",
  "version": "0.16.1",
  "description": "A local command center for teams of AI coding agents.",
  "author": "orcalinux",
  "homepage": "https://github.com/orcalinux/agent-hq",
  "repository": {
    "type": "git",
    "url": "https://github.com/orcalinux/agent-hq.git"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:lan": "vite --port 5173 --host",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview --port 5173",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "start": "npm run build && npm run build:electron && node dist-electron/server.cjs",
    "build:electron": "node scripts/build-electron.mjs",
    "desktop": "npm run build && npm run build:electron && electron .",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "dist:desktop": "npm run build && npm run build:electron && electron-builder --publish never",
    "test:desktop": "npm run build && npm run build:electron && playwright test -c playwright.desktop.config.ts",
    "test:updates:packaged": "node scripts/check-packaged-update.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:install": "bash scripts/test-clean-install.sh",
    "test:tiling": "npm run build && npm run build:electron && bash scripts/test-native-tiling.sh",
    "icons": "node scripts/render-icons.mjs",
    "demo": "bash demo/make.sh",
    "demo:capture": "AGENT_HQ_E2E_BUILT=1 playwright test -c playwright.demo.config.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/estree": "1.0.6",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "playwright": "1.64.1",
    "tailwindcss": "^4.0.0",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "^6.1.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@types/estree": "1.0.6",
    "minimatch@>=7 <11.0.1": "11.0.9"
  }
}
